# Игнорируем текстовые заметки и шаблоны
*.txt
*.docx
*.pdf
*.md

# Но НЕ игнорируем README.md — он нужен в репозитории
!README.md

# Папки с черновиками/шаблонами (если у тебя есть такие)
templates/
drafts/
notes/

# Файлы кэша и временные файлы
.DS_Store
Thumbs.db

# Локальные настройки VS Code (не надо коммитить настройки каждого разработчика)
.vscode/

# Виртуальные окружения Python (venv, .venv, env) — они тяжёлые и у каждого свои
venv/
.venv/
env/

# Артефакты сборки и кэши Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
